<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="resources\version" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HeadlessChromium.Puppeteer.Dotnet.OS.Fork" Version="1.1.1.1" />
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.7.0" />
    <PackageReference Include="OutSystems.ExternalLibraries.SDK.FileStorage" Version="1.0.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources/PrintLayout.png" />
    <EmbeddedResource Include="resources\version" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>UltimatePDF_ExternalLogic.Test.Helpers</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>UltimatePDF_ExternalLogic.UnitTests</_Parameter1>
    </AssemblyAttribute>
    <!--
      The File integration tests construct UltimatePDF_ExternalLogic through its internal test
      constructor to inject a fake IFileStorage, because the real storage only exists inside an ODC
      build. The alternative is making that constructor public, which would widen the public surface
      of the one ODC-facing class.
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>UltimatePDF_ExternalLogic.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
